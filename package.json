{
  "name": "assetshrink",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Private, browser-local SVG optimization by ConsoleLog Studio",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/finalize-export.mjs",
    "start": "node scripts/serve-static.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "svgo": "4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
